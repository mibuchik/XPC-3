# Maintainer: mibuchik <mibuch@example.com>
pkgname=xpc3-gui
pkgver=1.0.0
pkgrel=1
pkgdesc="Xalether Privacy Chain v3 - Cascade File and Folder Encryption"
arch=('x86_64')
url="https://github.com/mibuchik/XPC-3"
license=('custom:Xalether Proprietary')
depends=('qt5-base' 'openssl')
makedepends=('git' 'make' 'gcc')
source=("git+https://github.com/mibuchik/XPC-3.git")
md5sums=('SKIP')

build() {
    cd "$srcdir/XPC-3"
    make -C XPC-3-GUI clean
    make -C XPC-3-GUI
}

package() {
    cd "$srcdir/XPC-3"
    
    # Install the main executable
    install -Dm755 XPC-3-GUI/xpc3-gui "$pkgdir/usr/bin/xpc3-gui"
    
    # Install the desktop file and icon
    install -Dm644 XPC-3-GUI/xpc3-gui.desktop "$pkgdir/usr/share/applications/xpc3-gui.desktop"
    install -Dm644 XPC-3-GUI/icon.png "$pkgdir/usr/share/pixmaps/xpc3-gui.png"
    
    # Install the license file
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
